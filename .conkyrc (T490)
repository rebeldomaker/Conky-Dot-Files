conky.config = {

    -- font
    font = 'Hack:size=13',

    use_xft = true,
    xftalpha = 1,

    update_interval = 4, -- frequency of updating CPU/RAM usage stats

    total_run_times = 0,

    -- own window
    own_window = true,
    own_window_type = 'normal',
    own_window_transparent = true, -- if set to false, creates black transparent background in window
    own_window_argb_visual = true,
    own_window_argb_value = 50,
    own_window_hints = 'undecorated,below,sticky,skip_taskbar,skip_pager',

    double_buffer = true,

    -- window sizing
    minimum_width = 250,
    minimum_height = 750,
    maximum_width = 550,

    -- draw configs, text style and theme
    draw_shades = false,
    draw_outline = false,
    draw_borders = true,
    draw_graph_borders = true, -- changes the color of drawn borders if set to true

    -- colors
    default_color = '#50fa7b',
    color1 = '#4da6ff', -- Blue for default text
    color2 = '#00b38f', -- Aqua Green for headers
    color3 = '#ffaa00', -- CPU bar colors in yellow
    color4 = '#6666ff', -- for bars and other extras


    alignment = 'bottom_left',
    gap_x = 1508,
    gap_y = 60,

    no_buffers = true,
    uppercase = false,

    cpu_avg_samples = 3,

    override_utf8_locale = true,


};

conky.text = [[
${color2}${font Ubuntu:bold:size=12}SYSTEM ${hr 2}${font}
${color1}${execi 3600 lsb_release -ds}
${color1}Kernel: $kernel
${color4}Battery: ${battery_percent BAT0}% ${battery_bar BAT0}
${color1}Uptime: $uptime

${color2}${font Hack:bold:size=12}TOP CPU PROCESSES ${hr 2}${font}
${color1}${top name 1}            ${top cpu 1}%
${color1}${top name 2}            ${top cpu 2}%
${color1}${top name 3}            ${top cpu 3}%
${color1}${top name 4}            ${top cpu 4}%
${color1}${top name 5}            ${top cpu 5}%
${color1}${top name 6}            ${top cpu 6}%
${color1}${top name 7}            ${top cpu 7}%

${color2}${font Ubuntu:bold:size=11}CPU CORE USAGE ${hr 2}${font}
${color3}C1 | ${cpu cpu1}% ${cpubar cpu1}
${color3}C2 - ${cpu cpu2}% ${cpubar cpu2}
${color3}C3 | ${cpu cpu3}% ${cpubar cpu3}
${color3}C4 - ${cpu cpu4}% ${cpubar cpu4}
${color3}C5 | ${cpu cpu5}% ${cpubar cpu5}
${color3}C6 - ${cpu cpu6}% ${cpubar cpu6}
${color3}C7 | ${cpu cpu7}% ${cpubar cpu7}
${color3}C8 - ${cpu cpu8}% ${cpubar cpu8}
 ${cpugraph 100,380}

${color2}${font Ubuntu:bold:size=11}RAM STATS ${hr 2}${font}
${color1}${mem}/${memmax} | Free: $memeasyfree
${color1}Total Memory Use is ${memperc}% ${membar}

${color1}${top_mem name 1}                ${top_mem mem 1}% 
${color1}${top_mem name 2}                ${top_mem mem 2}%
${color1}${top_mem name 3}                ${top_mem mem 3}%
${color1}${top_mem name 4}                ${top_mem mem 4}%
${color1}${top_mem name 5}                ${top_mem mem 5}%
${color1}${top_mem name 6}                ${top_mem mem 6}%

${color2}${font Ubuntu:bold:size=11}STORAGE ${hr 2}${font}
${color1}Root: ${fs_used /} of ${fs_size /} (${fs_used_perc /}%)
${color4}Storage: ${fs_bar 6,140 /}

${color2}${font Ubuntu:bold:size=11}OTHER ${hr 2}${font}
${color1}Volume: ${exec amixer get Master | grep -o '[0-9]*%' | head -1}
${color1}Running Processes: $processes
${color1}Installed Packages: ${exec dpkg --get-selections | wc -l}
]];
